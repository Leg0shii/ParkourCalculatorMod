+    transitions = {t.key: t for t in graph.transitions}
+    initial=regions[region_path[0]]
+    events = [('start', initial.transit_key or initial.key)]
+    for key in transition_path:
+        t = transitions[key]
+        if t.kind == 'support_arrival':
+            events.append(('support', t.target))
+        elif t.kind == 'support_departure':
+            events.append(('departure',t.source,regions[t.target].transit_key or t.target))
+        elif t.kind == 'finish':
+            events.append(('finish', t.target))
+        elif t.kind == 'open_portal':
+            before = regions[t.source].transit_key or t.source
+            after = regions[t.target].transit_key or t.target
+            if before == after:
+                continue
+            events.append(('passage', before, after))
+    return tuple(events)
+
+
+def corridor_from_walk(scene, decomposition, graph, region_path, transition_path, *, route_id=0):
+    regions = {r.key: r for r in graph.regions}
+    transitions = {t.key: t for t in graph.transitions}
+    start = tuple(scene['initial']['position'])
+    destination = regions[region_path[-1]]
+    endpoint = conditioned_anchor(destination.cover, start, start) if destination.cover else start
+    if destination.kind == 'terminal_predicate':
+        endpoint = list(start)
+        endpoint[1] = destination.predicate['height']
+        for row in destination.predicate['rows']:
+            axis = 0 if row['mode'] == 'X' else 2
+            endpoint[axis] = (min if row['cmp'] == 'LE' else max)(endpoint[axis], row['rhs'])
+        endpoint = tuple(endpoint)
+    # Guide references use the neighboring selected support boundaries. Distant
+    # query-envelope corners and whole-air midpoints have no role in this guide.
+    references = {0: start, len(transition_path): endpoint}
+    for i, key in enumerate(transition_path):
+        t = transitions[key]
+        if t.kind == 'support_arrival':
+            references[i+1] = conditioned_anchor(t.cover, start, endpoint)
+    points = [start]
+    stages = []
+    for i, key in enumerate(transition_path):
+        t = transitions[key]
+        before = references[max(k for k in references if k <= i)]
+        after = references[min(k for k in references if k >= i+1)]
+        if t.cover:
+            points.append(conditioned_anchor(t.cover, before, after))
+        if t.kind != 'support_departure':
+            stages.append(dict(occurrence=len(stages), kind=t.kind, source=t.source, target=t.target,
+                transition=t.key, cover=t.cover, cells=regions[t.source].cells,
+                portals=t.portals, predicate=regions[t.target].predicate,guide_point=points[-1]))
+    if points[-1] != endpoint:
+        points.append(endpoint)
+    cells = sorted({c for key in region_path for c in regions[key].cells if regions[key].kind == 'air_volume'})
+    portals = [p for key in transition_path for p in transitions[key].portals]
+    variant = dict(regions=list(region_path), transitions=list(transition_path))
+    return Corridor(route_id, cells, portals, [list(p) for p in points], (),
+        projected_boxes(decomposition, cells), sum(math.dist(a,b) for a,b in zip(points, points[1:])),
+        source='automatic', stage_paths=[], schema=2, graph_context=graph.context,
+        semantic_key=semantic_events(graph, region_path, transition_path), stages=stages,
+        route_variants=[variant], region_graph=graph.to_dict())
+
+
+def enumerate_semantic_routes(scene, decomposition, graph, *, max_routes=50, max_expansions=5000,
+                              max_steps=64, max_visits=2, deadline=None, cancel_event=None, continuation=None):
+    import copy
+    from .regions import geometry_key
+    for key, value in dict(max_routes=max_routes, max_expansions=max_expansions,
+                           max_steps=max_steps, max_visits=max_visits).items():
+        if type(value) is not int or value < 1:
+            raise ValueError(key + ' must be a positive integer')
+    context = geometry_key((graph.context, max_steps, max_visits, scene['initial']))
+    if continuation is not None and (continuation.get('schema') != 1 or continuation.get('context') != context):
+        raise ValueError('Incompatible spatial continuation; graph or route domain changed')
+    state = copy.deepcopy(continuation) if continuation is not None else dict(schema=1, context=context,
+        frontier=[dict(regions=[s], transitions=[]) for s in graph.starts], emitted=[], expanded=0,
+        duplicates=0, depthDrops=0, visitDrops=0)
+    regions = {r.key: r for r in graph.regions}
+    adjacent = graph.neighbors()
+    targets = [b for key in graph.goals for b in regions[key].cover]
+    start = tuple(scene['initial']['position'])
+
+    def priority(walk):
+        cover = regions[walk['regions'][-1]].cover
+        # Minimum region distance is an ordering hint, not a transit-time bound.
+        distance = min((distance_to_box(conditioned_anchor(cover, start, start), b)
+                        for b in targets), default=0.) if cover else 0.
+        supports=[key for key in walk['regions'] if regions[key].kind=='support_surface']
+        unknown=sum(geometry_key((a,b)) not in graph.transfers for a,b in zip(supports,supports[1:])) if graph.transfers else 0
+        last=None;episode_unknown=False
+        for key in walk['regions']:
+            region=regions[key]
+            if region.kind=='support_surface':
+                last=key;episode_unknown=False
+            elif last in graph.flight_proposals:
+                proposal=graph.flight_proposals[last]
+                if region.kind=='air_volume' and not episode_unknown and all(b[1]>proposal['maxY']+1e-7 for b in region.cover):
+                    unknown+=1;episode_unknown=True
+                if region.kind=='terminal_predicate' and not proposal['normalFinish']:
+                    unknown+=1
+        if len(walk['regions'])>1 and regions[walk['regions'][0]].kind=='support_surface':
+            first=regions[walk['regions'][1]]
+            unknown+=int(not any(contains(b,start) for b in first.cover))
+        return (unknown,len(walk['transitions']), distance, tuple(walk['transitions']))
+
+    # Give newly discovered contact itineraries service before spending the
+    # entire route budget on raw passage encodings of one support sequence.
+    state.setdefault('served',{})
+    frontier = {}
+    serial = itertools.count()
+    def enqueue(walk):
+        family = next((key for key in reversed(walk['regions']) if regions[key].kind=='support_surface'),walk['regions'][0])
+        if walk['regions'][-1] in graph.goals:
+            family=(family,'terminal',walk['regions'][-2] if len(walk['regions'])>1 else walk['regions'][-1])
+        else:
+            family=(family,walk['regions'][-1])
+        if len(walk['regions'])>1:
+            family=geometry_key((walk['regions'][1],family))
+        else:
+            family=geometry_key(family)
+        heapq.heappush(frontier.setdefault(family,[]),(priority(walk),next(serial),walk))
+    for walk in state['frontier']:
+        enqueue(walk)
+    graph_data=graph.to_dict()
+    grouped = {geometry_key(c['semantic_key']): Corridor(**dict(c,region_graph=graph_data)) for c in state['emitted']}
+    expanded = 0
+    termination = 'exhausted'
+    while frontier:
+        if cancel_event is not None and cancel_event.is_set():
+            termination = 'cancelled'
+            break
+        if deadline is not None and time.monotonic() >= deadline:
+            termination = 'deadline'
+            break
+        if len(grouped) >= max_routes:
+            termination = 'route_limit'
+            break
+        if expanded >= max_expansions:
+            termination = 'expansion_limit'
+            break
+        family = min(frontier,key=lambda k:(frontier[k][0][0][0],state['served'].get(k,0),frontier[k][0][0][1:],k))
+        _, _, walk = heapq.heappop(frontier[family])
+        if not frontier[family]:
+            del frontier[family]
+        state['served'][family] = state['served'].get(family,0)+1
+        path, edges = walk['regions'], walk['transitions']
+        current = path[-1]
+        expanded += 1
+        if current in graph.goals:
+            corridor = corridor_from_walk(scene, decomposition, graph, path, edges, route_id=len(grouped))
+            corridor.region_graph=graph_data
+            key = geometry_key(corridor.semantic_key)
+            if key in grouped:
+                existing = grouped[key]
+                if corridor.route_variants[0] not in existing.route_variants:
+                    existing.route_variants.extend(corridor.route_variants)
+                    existing.variants = len(existing.route_variants)
+                state['duplicates'] += 1
+            else:
+                grouped[key] = corridor
+            continue
+        if len(path) >= max_steps:
+            state['depthDrops'] += 1
+            continue
+        for t in adjacent[current]:
+            if t.capability == 'ruled_out':
+                continue
+            if len(path) > 1 and t.target == path[-2] and t.kind != 'support_departure':
+                # Immediate face touch-and-return and same-neighborhood setup
+                # self-hops are local alternatives. Wider returns remain walks.
+                continue
+            last_contact = max((i for i,key in enumerate(path) if regions[key].kind=='support_surface'),default=0)
+            visits = path if regions[t.target].kind=='support_surface' else path[last_contact:]
+            if visits.count(t.target) >= max_visits:
+                state['visitDrops'] += 1
+                continue
+            next_walk = dict(regions=path+[t.target], transitions=edges+[t.key])
+            enqueue(next_walk)
+    state['expanded'] += expanded
+    state['frontier'] = [w for _, _, w in sorted(item for queue in frontier.values() for item in queue)]
+    state['emitted'] = [c.to_dict(include_graph=False) for c in grouped.values()]
+    return list(grouped.values()), dict(termination=termination, expanded=state['expanded'],
+        sessionExpanded=expanded, remaining=len(state['frontier']), routes=len(grouped),
+        rawWalks=state['expanded'], groupedDuplicates=state['duplicates'], depthDrops=state['depthDrops'],
+        visitDrops=state['visitDrops'], maxRoutes=max_routes, maxExpansions=max_expansions,
+        maxSteps=max_steps, maxVisits=max_visits, coverageProven=False, movementFeasibility='unresolved',
+        missingStart=not graph.starts, missingGoal=not graph.goals, continuation=state)
+
+
 def horizontal_trace(candidate):
     positions = candidate['positions']
     ys = candidate.get('y', [0.] * len(positions))
diff --git a/standalone/autonomy/cell_routes/semantic_adapter.py b/standalone/autonomy/cell_routes/semantic_adapter.py
new file mode 100644
index 00000000..d8605a3f
--- /dev/null
+++ b/standalone/autonomy/cell_routes/semantic_adapter.py
@@ -0,0 +1,187 @@
+"""Immutable stage views of a typed corridor for the existing movement DFS."""
+
+import copy
+
+from .local import CorridorAdapter
+from .regions import geometry_key
+from .route_guards import RouteGuards, physical_events
+from .route_progress import advance, initial_cursor, phase_trace
+
+
+class SemanticCorridorAdapter(CorridorAdapter):
+    def __init__(self, scene, corridor, *, decomposition=None):
+        if corridor.schema != 2:
+            raise ValueError('Semantic adapter requires corridor schema2')
+        super().__init__(scene,corridor,[],decomposition=decomposition)
+        self.full_corridor = corridor
+        self.program = None
+        self.goal_index = None
+        self.contact_phase_only = False
+
+    def goals(self):
+        regions = {r['key']:r for r in self.full_corridor.region_graph['regions']}
+        edges = {t['key']:t for t in self.full_corridor.region_graph['transitions']}
+        result = []
+        for key in self.full_corridor.route_variants[0]['transitions']:
+            edge = edges[key]
+            target = regions[edge['target']]
+            if edge['kind']=='support_arrival':
+                blocks = [b['id'] for b in self.scene['blocks'] if b['solidIndex'] in target['solids']]
+                result.append(dict(kind='landing',block=blocks[0],blocks=blocks,surface=target['key']))
+            elif edge['kind']=='finish':
+                result.append(copy.deepcopy(target['predicate']))
+        return result
+
+    def for_goal(self, index):
+        result = copy.copy(self)
+        result.corridor = copy.deepcopy(self.full_corridor)
+        edges = {t['key']:t for t in self.full_corridor.region_graph['transitions']}
+        variants = []
+        for variant in self.full_corridor.route_variants:
+            seen = -1
+            stop = len(variant['transitions'])
+            required = len(variant['regions'])-1
+            for i, key in enumerate(variant['transitions']):
+                if edges[key]['kind'] in ('support_arrival','finish'):
+                    seen += 1
+                    if seen == index:
+                        required=i+1
+                    elif seen == index+1:
+                        # The current landing can run off in its remaining X/Z
+                        # phases. Permit the selected outgoing air itinerary,
+                        # without requiring its next contact/finish yet.
+                        stop=i
+                        break
+            variants.append(dict(regions=variant['regions'][:stop+1],transitions=variant['transitions'][:stop],required=required))
+        result.corridor.route_variants = variants
+        result.corridor.graph_context = geometry_key((self.full_corridor.graph_context,index,variants))
+        result.goal_index = index
+        final=variants[0]
+        regions={r['key']:r for r in self.full_corridor.region_graph['regions']}
+        result.contact_phase_only=(final['required']==len(final['regions'])-1 and
+            regions[final['regions'][final['required']]]['kind']=='support_surface')
+        result.program = None
+        result.progress_cache = {}
+        return result
+
+    def outgoing_objective(self,index):
+        from .checkpoints import Checkpoint, horizontal_segments
+        goals = [i for i,s in enumerate(self.full_corridor.stages) if s['kind'] in ('support_arrival','finish')]
+        after = goals[index]
+        guide = copy.copy(self.full_corridor)
+        guide.points = [s['guide_point'] for s in self.full_corridor.stages[after:]]
+        segments = horizontal_segments(guide)
+        if not segments:
+            return self.scene['objective']
+        first=segments[0]
+        return Checkpoint(1,-1,first['direction'],tuple(first['start']),tuple(first['end']),()).objective
+
+    def bind_program(self, program):
+        result = copy.copy(self)
+        result.program = program
+        return result
+
+    def context(self, context):
+        # The existing InteractionGate still applies after this adapter. Keep
+        # all physical parts of each selected support, not just one box ID.
+        super().context(context)
+        positions=self.program_states(context['program'])
+        if positions is None:
+            return
+        regions={r['key']:r for r in self.full_corridor.region_graph['regions']}
+        goals=self.goals()
+        solids=set()
+        for index,last in positions:
+            solids.update(regions[last]['solids'])
+            if index<len(goals) and goals[index]['kind']=='landing' and (self.goal_index is None or index<=self.goal_index):
+                solids.update(regions[goals[index]['surface']]['solids'])
+        context['supportAllowed']=lambda block:block['solidIndex'] in solids
+
+    def program_states(self,program):
+        regions={r['key']:r for r in self.full_corridor.region_graph['regions']}
+        start=self.full_corridor.route_variants[0]['regions'][0]
+        if regions[start]['kind']!='support_surface':
+            # No fabricated contact interpretation for an airborne root.
+            return None
+        goals=self.goals()
+        possible={(0,start)}
+        for event in sorted(program['profile'].get('contactEvents',[]),key=lambda e:e['offset']):
+            if event['axis']!='Y' or event.get('direction')!=-1:
+                continue
+            indices={b['solidIndex'] for b in self.scene['blocks']
+                     if self.scene['collisionScene']['solids'][b['solidIndex']]==event['box']}
+            def matches(key):
+                region=regions[key]
+                return bool(indices.intersection(region['solids']) and
+                            any(abs(b[1]-event['plane'])<=1e-7 for b in region['cover']))
+            following=set()
+            for index,last in possible:
+                if matches(last):
+                    following.add((index,last))
+                if index<len(goals) and goals[index]['kind']=='landing' and matches(goals[index]['surface']):
+                    following.add((index+1,goals[index]['surface']))
+            possible=following
+            if not possible:
+                break
+        return possible
+
+    def program_allowed(self,program):
+        positions=self.program_states(program)
+        return positions is None or any(self.goal_index is None or index<=self.goal_index+1 for index,_ in positions)
+
+    def scoped(self, scope):
+        result = copy.copy(self)
+        result.validation_scope = scope
+        return result
+
+    def eligible(self, envelopes, through):
+        # No horizontal landmark gates are used by the typed route contract.
+        return self
+
+    def _omitted(self):
+        scope = getattr(self,'validation_scope',None)
+        return scope is not None and (scope['purpose']=='preliminary' or
+                                      len(scope['solidIndices']) != len(self.scene['collisionScene']['solids']))
+
+    def constraint_guards(self, profile, envelopes, scope, deadline):
+        if self._omitted():
+            return None
+        return RouteGuards(self.scene,self.corridor,profile,scope['through'],complete=True,
+                           envelopes=envelopes,deadline=deadline,
+                           phase_count=3*scope['through']-2 if self.contact_phase_only and
+                           scope['through']==profile['airtime'] and profile.get('landingPhase')=='pre' else None)
+
+    def candidate(self, plan, candidate, vertical, *, partial=False):
+        self.counts['corridorAudits'] += 1
+        if self._omitted():
+            return dict(accepted=True,routeCertified=False,validation='preliminary_route_requirements_omitted')
+        if self.program is None:
+            raise ValueError('Semantic route validation needs the selected physical program')
+        phases = phase_trace(dict(candidate,y=vertical['y']))
+        profile = self.program['profile']
+        if self.contact_phase_only and profile.get('landingPhase')=='pre':
+            phases=phases[:-2]
+        uncertain = {e['input'] for e in profile.get('caseEvents',[])}
+        for phase in phases:
+            if phase['input'] in uncertain:
+                phase['uncertainProbes'] = True
+        events = [dict(phase=p,owner=owner) for p,owners in physical_events(self.scene,profile).items()
+                  for owner in sorted(owners) if p < len(phases)]
+        virtual = self.program.get('terminalGoal')
+        if virtual is not None:
+            from ..terminal_goals import satisfied
+            events.append(dict(kind='finish',phase=len(phases)-1,
+                validated=satisfied(self.program,candidate,virtual,self.scene.get('supportClearance',1e-6))))
+        checked = advance(self.corridor,initial_cursor(self.corridor),phases,events,dict(complete=True))
+        accepted = checked['status']=='compatible' and checked['complete']
+        self.counts['corridorRejections'] += int(not accepted)
+        self.counts['routeUnknowns'] += int(checked['status']=='unknown')
+        return dict(accepted=accepted, reason=None if accepted else 'semantic_route_'+checked['status'],
+                    routeCertified=accepted, routeProgress=checked, alternatives=[], repairComplete=False,
+                    routeHorizonPhase=phases[-1]['phase'] if phases else None,
+                    routeRequirement='physical_contact_phase' if self.contact_phase_only else 'selected_goal_with_outgoing_regions',
+                    requiredOccurrences=[v.get('required',len(v['regions'])-1) for v in self.corridor.route_variants])
+
+    def summary(self):
+        return dict(self.counts,schema=2,graphContext=self.full_corridor.graph_context,
+                    filtering='fixed_3d_axis_sweeps_and_physical_contact_itinerary',originalInitialState=self.initial)
