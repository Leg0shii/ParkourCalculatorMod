index 00000000..186bcd49
--- /dev/null
+++ b/standalone/autonomy/cell_routes/anchor_adapter.py
@@ -0,0 +1,104 @@
+"""Required-anchor stages on the existing event/physical movement engine."""
+
+import copy
+
+from ..solve_spec import digest
+from .event_adapter import EventGuideAdapter, EventReference
+from .anchor_policy import audit, owner, visit_state, semantic_settings
+from .anchor_guides import build_guides, onward_objective
+
+
+class AnchorAdapter(EventGuideAdapter):
+    def __init__(self, data, graph, policy, **kwargs):
+        super().__init__(data,graph,**kwargs)
+        self.anchor_policy=policy
+        self.guide_plan=build_guides(data,policy)
+        self.node_query=False
+
+    def initial_cursor(self, roots):
+        cursor=super().initial_cursor(roots)
+        checks=[audit(self.scene,p,self.anchor_policy['anchors']) for p in roots]
+        if any(not a['accepted'] for a in checks) or len({a['reached'] for a in checks})!=1:
+            raise ValueError('Anchor roots violate ordered/no-return domain')
+        index=checks[0]['reached']
+        cursor.update(anchorIndex=index,spanStart=checks[0]['ticks'][-1] if index else 0)
+        return cursor
+
+    def next_goals(self, cursor, parents, continuation=None, *, budget=None):
+        if continuation is not None and continuation['exhausted']:
+            return [],continuation,dict(expansions=0,materializations=0)
+        budget=budget or {}
+        if budget.get('check'):budget['check']()
+        index=cursor['anchorIndex']; anchors=self.anchor_policy['anchors']
+        target=anchors[index] if index<len(anchors) else self.data['task']['block']
+        terminal=index==len(anchors)
+        requests=[]
+        for event in self.graph['events']:
+            if event['terminal']!=terminal:
+                continue
+            goal=event['goal']
+            if goal['kind']!='landing' or target not in goal.get('blocks',[goal['block']]):
+                continue
+            request=dict(schema=1,id='anchor-request:'+digest([cursor,event['id'],target]),
+                event=event['id'],goal=dict(goal,block=target,blocks=[target]),terminal=terminal,
+                commitments=[],semanticPrefix=[],afterTick=min(p['profile']['airtime'] for p in parents),
+                connector=dict(entry=cursor['attachments'],exit=event['attachments']))
+            requests.append(request)
+        if not requests:
+            raise ValueError('Required anchor has no exposed contact event: '+target)
+        return requests,dict(exhausted=True),dict(expansions=0,materializations=len(requests))
+
+    def for_goal(self, request, cursor):
+        result=copy.copy(self)
+        result.request=copy.deepcopy(request);result.cursor=copy.deepcopy(cursor)
+        span=cursor['anchorIndex']
+        points=self.guide_plan['points']
+        result.guide=dict(version=1,id=self.guide_plan['id']+':'+str(span),
+                          points=points[span:span+2],target=points[span+1],hardConstraints=False)
+        result.objective=onward_objective(self.guide_plan,span,self.scene['objective'])
+        result.score_context=digest(dict(request=request,guide=result.guide,objective=result.objective,
+                                         policy=semantic_settings(self.anchor_policy)))
+        result.corridor=EventReference(self.data['domainId'],request['id'],result.guide['id'])
+        result.program=None
+        return result
+
+    def for_node(self):
+        result=copy.copy(self);result.node_query=True
+        return result
+
+    def advance(self, cursor, child, observed, request):
+        result=super().advance(cursor,child,observed,request)
+        result['anchorIndex']+=1
+        result['spanStart']=child['profile']['airtime']
+        return result
+
+    def context(self, context):
+        state=visit_state(self.scene,context['program'])
+        index=self.cursor['anchorIndex']
+        forbidden={owner(self.scene,a) for a in self.anchor_policy['anchors'][index+1:]}
+        if index<len(self.anchor_policy['anchors']):
+            forbidden.add(owner(self.scene,self.data['task']['block']))
+        context['supportAllowed']=lambda block: (owner(self.scene,block['id']) not in state['departed'] and
+                                                owner(self.scene,block['id']) not in forbidden)
+        context['landingAllowed']=context['supportAllowed']
+
+    def program_allowed(self, program):
+        return audit(self.scene,program,self.anchor_policy['anchors'],
+                     reached=self.cursor['anchorIndex'])['accepted']
+
+    def contact_regions(self, program, through):
+        return None if self.node_query else super().contact_regions(program,through)
+
+    def candidate(self, plan, candidate, vertical, *, partial=False):
+        prior=audit(self.scene,self.program,self.anchor_policy['anchors'],
+                    reached=self.cursor['anchorIndex'])
+        if not prior['accepted']:
+            return dict(prior,alternatives=[])
+        if self.node_query:
+            return dict(accepted=True,requiredEventsSatisfied=True,taskSatisfied=False,
+                        validation='exact_node_prior_anchors_only',alternatives=[])
+        return super().candidate(plan,candidate,vertical,partial=partial)
+
+    def summary(self):
+        return dict(super().summary(),anchorPolicy=self.anchor_policy,guidePlan=self.guide_plan,
+                    backend='anchor_goals_v1',visitScope='acyclic_owners_with_current_owner_hops')
diff --git a/standalone/autonomy/cell_routes/anchor_guides.py b/standalone/autonomy/cell_routes/anchor_guides.py
new file mode 100644
index 00000000..ef50ac10
--- /dev/null
+++ b/standalone/autonomy/cell_routes/anchor_guides.py
@@ -0,0 +1,100 @@
+"""Backward finite guide projection and one observable binary approach edge."""
+
+import math
+
+from ..solve_spec import digest
+from .checkpoints import Checkpoint
+
+
+def nearest(cover, point):
+    if not cover:
+        raise ValueError('Anchor has no exposed landing region')
+    choices = [tuple(min(max(point[a],b[a]),b[a+3]) for a in range(3)) for b in cover]
+    return min(choices,key=lambda p:(math.dist(p,point),p))
+
+
+def landing_cover(data, block):
+    scene=data['scene']
+    b=next(b for b in scene['blocks'] if b['id']==block)
+    return [box for s in data['geometry']['supports'] if b['solidIndex'] in s['solids']
+            and s['height']==b['top'] for box in s['cover']]
+
+
+def terminal_point(data):
+    scene=data['scene']; task=data['task']
+    if task['kind']!='landing':
+        raise ValueError('Anchor search requires a finite physical landing task')
+    b=next(b for b in scene['blocks'] if b['id']==task['block'])
+    boxes=[scene['collisionScene']['solids'][b['solidIndex']]]
+    objective=scene['objective']
+    axis=0 if objective['axis']=='X' else 2
+    high=objective['sense']=='MAX'
+    edge=(max if high else min)(box[axis+3 if high else axis] for box in boxes)
+    other=2-axis
+    point=[0.,b['top'],0.]
+    point[axis]=edge
+    point[other]=(min(v[other] for v in boxes)+max(v[other+3] for v in boxes))/2
+    return point
+
+
+def unit(x,z):
+    length=math.hypot(x,z)
+    return None if length<=1e-12 else (x/length,z/length)
+
+
+def build_guides(data, policy):
+    scene=data['scene']; names=[scene['startBlock']]+policy['anchors']+[data['task']['block']]
+    points=[None]*len(names);points[-1]=terminal_point(data)
+    covers={name:landing_cover(data,name) for name in names}
+    for i in range(len(names)-2,0,-1):
+        points[i]=list(nearest(covers[names[i]],points[i+1]))
+    points[0]=list(scene['initial']['position'])
+    footprints={name:[scene['collisionScene']['solids'][b['solidIndex']] for b in scene['blocks'] if b['id']==name]
+                for name in names}
+    result=dict(version=1,anchors=names,points=points,covers=covers,physicalFootprints=footprints,turns=[])
+    for i in range(1,len(names)-1):
+        s,e,n=points[i-1:i+2]
+        incoming=unit(e[0]-s[0],e[2]-s[2]); away=unit(e[0]-n[0],e[2]-n[2])
+        if incoming is None or away is None:
+            continue
+        angle=math.degrees(math.acos(max(-1.,min(1.,-sum(a*b for a,b in zip(incoming,away))))))
+        if angle<=policy['turnaround']['degrees']:
+            continue
+        normal=unit(incoming[0]+away[0],incoming[1]+away[1])
+        if normal is None:
+            continue
+        b=next(b for b in scene['blocks'] if b['id']==names[i])
+        box=scene['collisionScene']['solids'][b['solidIndex']]
+        footprint=[[x,z] for x in (box[0],box[3]) for z in (box[2],box[5])]
+        c=min(normal[0]*x+normal[1]*z for x,z in footprint)
+        turn=dict(version=1,index=i,anchor=names[i],S=s,E=e,N=n,angleDegrees=angle,
+                  normal=list(normal),offset=c,margin=policy['turnaround']['spatialMargin'],
+                  units='blocks',footprint=footprint,spans=[i-1,i])
+        turn['id']='turn:'+digest(turn)
+        result['turns'].append(turn)
+    result['id']='guides:'+digest(result)
+    return result
+
+
+def classify(guides, span, point):
+    distances=[]
+    for turn in guides['turns']:
+        if span not in turn['spans']:
+            continue
+        raw=sum(a*b for a,b in zip(turn['normal'],point))-turn['offset']
+        distances.append(dict(boundary=turn['id'],rawDistance=raw,
+                              shiftedDistance=raw+turn['margin'],inside=raw+turn['margin']>=0))
+    return dict(version=1,guide=guides['id'],span=span,point=list(point),
+                isTurnaround=any(d['inside'] for d in distances),distances=distances)
+
+
+def onward_objective(guides, span, fallback):
+    # At E aim onward to N, rather than back toward E's landing point.
+    i=span+1
+    if i+1>=len(guides['points']):
+        return dict(fallback)
+    e,n=guides['points'][i:i+2]
+    direction=unit(n[0]-e[0],n[2]-e[2])
+    if direction is None:
+        return dict(fallback)
+    return Checkpoint(1,-1,direction,tuple(e),tuple(n),()).objective
diff --git a/standalone/autonomy/cell_routes/anchor_policy.py b/standalone/autonomy/cell_routes/anchor_policy.py
new file mode 100644
index 00000000..cc99bc44
--- /dev/null
+++ b/standalone/autonomy/cell_routes/anchor_policy.py
@@ -0,0 +1,175 @@
+"""Declared milestones and acyclic physical-owner visits, including local hops."""
+
+import copy
+
+from ..solve_spec import digest
+
+
+HARD_JUMP_POLICY_VERSION = 2
+
+
+def settings(value, scene):
+    result = dict(version=1, anchors=[], turnaround=dict(degrees=110., spatialMargin=.3),
+                  solveEveryDecisionLevels=1, feasibilityPolicy='ipopt_oracle', observability=True)
+    if not isinstance(value, dict) or set(value)-set(result):
+        raise ValueError('Unsupported anchorSearch fields')
+    result.update(copy.deepcopy(value))
+    names = {b['id'] for b in scene['blocks']}
+    anchors = result['anchors']
+    if (not isinstance(anchors, list) or len(set(anchors)) != len(anchors) or
+            any(a not in names for a in anchors)):
+        raise ValueError('Anchors must be ordered unique scene blocks')
+    if scene['startBlock'] in anchors or scene['goalBlock'] in anchors:
+        raise ValueError('Initial and terminal supports are implicit endpoints')
+    if result['version'] != 1 or result['feasibilityPolicy'] != 'ipopt_oracle':
+        raise ValueError('Unsupported anchor policy')
+    if type(result['solveEveryDecisionLevels']) is not int or result['solveEveryDecisionLevels'] < 1:
+        raise ValueError('Decision solve interval must be positive')
+    if type(result['observability']) is not bool:
+        raise ValueError('observability must be boolean')
+    turn = result['turnaround']
+    if not isinstance(turn, dict) or set(turn)-{'degrees','spatialMargin'}:
+        raise ValueError('Unsupported turnaround settings')
+    result['turnaround'] = dict(degrees=110., spatialMargin=.3) | turn
+    import math
+    if any(isinstance(v, bool) or not isinstance(v, (int,float)) or not math.isfinite(v)
+           for v in result['turnaround'].values()):
+        raise ValueError('Turn settings must be finite numbers')
+    if not 0 < result['turnaround']['degrees'] < 180 or result['turnaround']['spatialMargin'] < 0:
+        raise ValueError('Invalid turn angle or margin')
+    return result
+
+
+def semantic_settings(policy):
+    return dict({k:v for k,v in policy.items() if k!='observability'},
+                hardJumpPolicyVersion=HARD_JUMP_POLICY_VERSION,searchPolicyVersion=4)
+
+
+def owner(scene, block):
+    b = next((b for b in scene['blocks'] if b['id'] == block), None)
+    return b.get('sourceBlock', b['id']) if b else block
+
+
+def visits(scene, program):
+    """Read actual selected contacts, never profile height or transient air IDs."""
+    by_box = {tuple(scene['collisionScene']['solids'][b['solidIndex']]): owner(scene,b['id'])
+              for b in scene['blocks']}
+    events = [(e['offset'], 0, e) for e in program['profile'].get('contactEvents', [])
+              if e['axis'] == 'Y' and e.get('direction') == -1]
+    profile=program['profile']
+    for e in profile.get('caseEvents', []):
+        t=e['input']+1
+        # A cancel/grind touches geometry without landing on its owner. Keep
+        # its requested impulse and physical case, but do not invent a visit.
+        if e.get('lowerBox') is not None:
+            events.append((e['input'],1,dict(box=e['lowerBox'])))
+        box=e.get('box')
+        if box and profile['grounded'][t] and abs(profile['position'][t]-box[4])<=1e-7:
+            events.append((e['input'],2,e))
+    result = [(0, owner(scene,scene['startBlock']))]
+    for tick, _, e in sorted(events, key=lambda x:(x[0],x[1],digest(x[2]))):
+        name = by_box.get(tuple(e.get('box', ())))
+        if name is not None:
+            result.append((tick+1, name))
+    # Some named profiles report only terminalSupport. Include its physical
+    # owner without collapsing the input/jump history used by the solver.
+    if program.get('terminalSupport') is not None:
+        result.append((program['profile']['airtime'], owner(scene,program['terminalSupport'])))
+    return result
+
+
+def visit_state(scene, program):
+    current = None
+    departed = set()
+    valid = True
+    for _, name in visits(scene,program):
+        if name == current:
+            continue
+        if name in departed:
+            valid = False
+        if current is not None:
+            departed.add(current)
+        current = name
+    return dict(version=1, current=current, departed=sorted(departed), valid=valid)
+
+
+def audit(scene, program, anchors, *, reached=None):
+    state = visit_state(scene,program)
+    if not state['valid']:
+        return dict(accepted=False, reason='departed_owner_return', visits=state)
+    required = [owner(scene,a) for a in anchors]
+    index = 0
+    times = []
+    for tick, name in visits(scene,program):
+        if name in required[index:]:
+            if name != required[index]:
+                return dict(accepted=False, reason='required_anchor_order', visits=state)
+            times.append(tick)
+            index += 1
+    accepted = reached is None or index >= reached
+    return dict(accepted=accepted, reason=None if accepted else 'missing_prior_anchor',
+                visits=state, reached=index, ticks=times)
+
+
+def local_counts(program, start=0):
+    p=program['profile']; n=p['airtime']
+    if not 0 <= start <= n:
+        raise ValueError('Anchor span starts outside the program')
+    jumps=sum(bool(p['grounded'][t] and p['jump'][t]) for t in range(start,n))
+    runs=sum(bool(p['grounded'][t] and not p['jump'][t]) for t in range(start,n))
+    return dict(T=n, J=jumps, R=runs, A=n-start-jumps-runs, start=start)
+
+
+def priority(program, start=0, turnaround=False, identity=''):
+    c=local_counts(program,start)
+    return (c['T'], -c['J'], c['A'] if turnaround else c['R'], identity)
+
+
+def within_caps(request, program):
+    """Honor declared limits without importing legacy scene defaults as caps."""
+    c=local_counts(program)
+    if any(name in request and c[key]>request[name] for name,key in
+           (('maxJumps','J'),('maxTotalRunTicks','R'))):
+        return False
+    if 'maxRunTicksPerJump' in request:
+        run=0;p=program['profile']
+        for t in range(p['airtime']):
+            run=run+1 if p['grounded'][t] and not p['jump'][t] else 0
+            if run>request['maxRunTicksPerJump']:return False
+    return True
+
+
+def transfer_structure(scene, program, start, source, target, *, complete=False):
+    """Separate source-local momentum preparation from the transfer flight.
+
+    Each actual return to the source closes a setup hop. The pending/complete
+    flight after the last source contact has at most/exactly one requested
+    jump. A source contact during the target's arrival input belongs to that
+    transfer's physical case, not an earlier setup boundary.
+    """
+    p=program['profile'];n=p['airtime']
+    launches=[t for t in range(start,n) if p['grounded'][t] and p['jump'][t]]
+    source,target=owner(scene,source),owner(scene,target)
+    contacts=[(t,name) for t,name in visits(scene,program) if start<t<=n]
+    arrival=min((t for t,name in contacts if name==target),default=None)
+    boundary=max([start]+[t for t,name in contacts if name==source and (arrival is None or t<arrival)])
+    preparation=[t for t in launches if t<boundary]
+    transfer=[t for t in launches if t>=boundary and (arrival is None or t<arrival)]
+    reason=None
+    if any(name not in (source,target) for _,name in contacts):
+        reason='intermediate_support_between_anchors'
+    elif arrival is not None and any(t>arrival and name==source for t,name in contacts):
+        reason='return_after_target_arrival'
+    elif arrival is not None and any(t>=arrival for t in launches):
+        reason='jump_after_target_arrival'
+    elif len(transfer)>1:
+        reason='multiple_transfer_impulses'
+    elif complete and (arrival is None or len(transfer)!=1):
+        reason='missing_transfer_jump'
