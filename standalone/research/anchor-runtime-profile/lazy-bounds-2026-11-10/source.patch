+                witness=dict(plan=dict(ticks=n,walls=[]),allocation=[0],cost=0,
+                    candidate=dict(yaw=[0.]*n,positions=[[.5,.5]]*(n+1),velocity=[[0.,0.]]*(n+1),objective=0.)))
